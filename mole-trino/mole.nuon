# mole manifest — a PLUGIN (data source) for Trino.
#   api / deps — see mole-psql for the shared schema. `api` is the ONE version
#                constraint mole checks; `deps` is one unified list, each entry
#                tagged `kind` "submodule" or "cli", checked for PRESENCE only.
# Needs Trino ≥400 — the CLI options used (--server / --catalog / --schema /
# --user / --execute / --output-format CSV_HEADER) predate it (documentation,
# not an enforced constraint).
{
  kind: "plugin"
  driver: "trino"
  version: "0.1.0"
  api: "^0.1.0"
  family: "sql"
  suffix: ".sql"
  deps: [
    { kind: "submodule", name: "mole-sql" }
    { kind: "cli", name: "trino" }
  ]
  summary: "Trino"
}
