# mole manifest — the mole-mermaid "library", a user-facing exception to the
# file-only library rule (like mole-sqls): it ships a mod.nu so it loads as
# `use mole-mermaid` and exposes a single verb, `mole-mermaid er-schema`.
# It is PURE and fully standalone — mod.nu imports nothing from mole core (the
# schema record arrives on the pipeline from any SQL plugin's `schema --full`),
# so its api requirement on core is FREE (declared `*`). No `deps`: it depends on
# the mole-sql schema-cache SHAPE structurally, not by import.
{
  kind: "lib"
  version: "0.1.0"
  api: "*"
  deps: []
  summary: "Render a SQL schema cache as a Mermaid diagram (mole-mermaid er-schema)"
}
