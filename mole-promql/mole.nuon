# mole manifest — a LIBRARY, not a plugin/driver. Generic Prometheus-HTTP-API
# helpers shared by metrics plugins (mole-prometheus, mole-victoriametrics, …). It
# is PURE: it imports nothing (not even mole core) and does no I/O and reads no
# clock, so its api requirement on core is FREE — declared `*` (any). It has no
# dependencies of either kind (`deps: []`). `version` is its own release;
# dialect plugins list it as a `submodule` dep (presence-checked).
{
  kind: "lib"
  version: "0.1.0"
  api: "*"
  deps: []
  summary: "Prometheus HTTP-API helpers (library)"
}
