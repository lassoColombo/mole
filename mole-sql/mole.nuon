# mole manifest — a LIBRARY, not a plugin/driver. Generic SQL helpers shared by
# dialect plugins (mole-psql, mole-mysql, …). It is PURE: it imports nothing (not
# even mole core), so its api requirement on core is FREE — declared `*` (any).
# It has no dependencies of either kind (`deps: []`). `version` is its own
# release; dialect plugins list it as a `submodule` dep (presence-checked).
{
  kind: "lib"
  version: "0.1.0"
  api: "*"
  deps: []
  summary: "Generic SQL helpers (library)"
}
