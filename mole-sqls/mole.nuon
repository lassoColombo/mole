# mole manifest — the mole-sqls "library", the ONE user-facing exception to the
# file-only library rule: it ships a mod.nu so it loads as `use mole-sqls` and
# exposes a single verb, `mole-sqls cfg translate`. Unlike the pure libs it is NOT
# standalone — mod.nu reads connections from mole core (`conn list`), so its api
# requirement on core is real (still declared `*`). The pure translation core in
# sqls.nu stays dependency-free. No `deps` (core is the api dep, not a submodule).
{
  kind: "lib"
  version: "0.1.0"
  api: "*"
  deps: []
  summary: "Translate mole connections to a sqls config (mole-sqls cfg translate)"
}
