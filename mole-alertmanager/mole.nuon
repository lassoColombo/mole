# mole manifest — a PLUGIN (data source) for Prometheus Alertmanager. It talks to
# Alertmanager over its v2 HTTP API using Nushell's built-in `http`, so it has no
# dependencies at all — neither a driven CLI nor a module dependency (`deps: []`).
# The generated `client.nu` is a build artifact, not a runtime dependency. `api`
# is its mole-core requirement — a native semver-range, checked at load by
# `version require-api` and by `mole submodules doctor`.
{
  kind: "plugin"
  driver: "alertmanager"
  version: "0.1.0"
  api: "^0.1.0"
  family: "prometheus"
  deps: []
  summary: "Prometheus Alertmanager (v2 HTTP API, read-only)"
}
